# ── Public (sent to the browser; safe to expose) ─────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Server-only (never sent to the browser; no NEXT_PUBLIC_ prefix) ───────
# Supabase secret key (sb_secret_...): bypasses row-level security. Only for server code.
SUPABASE_SECRET_KEY=

# Anthropic API key for the upcoming AI features (study plans, mock analysis). Optional for now.
ANTHROPIC_API_KEY=

# Who can open /admin: comma-separated emails of accounts you sign in with.
ADMIN_EMAILS=

# ── Push reminders (planner) ──────────────────────────────────────────────
# Generate once: npx web-push generate-vapid-keys. The public key is sent to browsers; the private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URL (or mailto:) the push services can reach you at.
VAPID_SUBJECT=
# Shared secret for GET /api/cron/reminders (sent as "Authorization: Bearer <CRON_SECRET>" by the scheduler).
CRON_SECRET=
